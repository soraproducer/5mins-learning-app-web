# PostgreSQL Database
DATABASE_URL=postgresql+asyncpg://username@localhost:5432/5mins_learning

# LLM API Keys (Optional - leave empty to disable external LLMs)
# Get your API keys from:
# - OpenAI: https://platform.openai.com/api-keys
# - Anthropic: https://console.anthropic.com/
# - Google: https://aistudio.google.com/app/apikey
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=

OPENAI_MODEL=gpt-5.4-mini
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
GEMINI_MODEL=gemini-2.5-flash-lite

# Local LLM (Ollama) - Required for summarization
# Make sure Ollama is installed and running: https://ollama.ai/
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gemma3:4b
